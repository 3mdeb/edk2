[Defines]
  INF_VERSION                    = 1.25
  BASE_NAME                      = IoMmuDxe
  FILE_GUID                      = 0e9830e7-c781-4c8b-83cd-ef984ca3817b
  MODULE_TYPE                    = DXE_DRIVER
